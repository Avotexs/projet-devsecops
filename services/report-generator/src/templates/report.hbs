<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Security Report - {{id}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
      background: linear-gradient(135deg, #0f0f23 0%, #1a1a3e 100%); 
      color: #e2e8f0; 
      line-height: 1.6; 
      min-height: 100vh;
    }
    .container { max-width: 1000px; margin: 0 auto; padding: 2rem; }
    
    .header { 
      background: rgba(255,255,255,0.05); 
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.1);
      color: white; 
      padding: 2.5rem; 
      border-radius: 16px; 
      margin-bottom: 2rem; 
      text-align: center;
    }
    .header h1 { 
      font-size: 2.5rem; 
      margin-bottom: 1rem; 
      background: linear-gradient(90deg, #63b3ed, #4fd1c5);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .meta { opacity: 0.7; font-size: 0.9rem; }
    .meta p { margin: 0.25rem 0; }
    
    .score-card { 
      background: rgba(255,255,255,0.05); 
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 16px; 
      padding: 3rem; 
      margin-bottom: 2rem; 
      text-align: center; 
    }
    .score { 
      font-size: 5rem; 
      font-weight: bold; 
      text-shadow: 0 0 30px currentColor;
    }
    .score.good { color: #48bb78; }
    .score.warning { color: #ecc94b; }
    .score.critical { color: #fc8181; }
    .grade { 
      font-size: 1.5rem; 
      color: #a0aec0; 
      margin-top: 0.5rem;
    }
    
    .summary { 
      display: flex; 
      justify-content: center; 
      gap: 3rem; 
      margin-top: 2rem; 
    }
    .summary-item { 
      text-align: center; 
      padding: 1.5rem 2rem;
      background: rgba(0,0,0,0.2);
      border-radius: 12px;
    }
    .summary-count { 
      font-size: 2.5rem; 
      font-weight: bold; 
    }
    .summary-label { 
      font-size: 0.9rem; 
      color: #a0aec0; 
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .high { color: #fc8181; }
    .medium { color: #ecc94b; }
    .low { color: #48bb78; }
    
    .section { 
      background: rgba(255,255,255,0.05); 
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 16px; 
      padding: 2rem; 
      margin-bottom: 1.5rem; 
    }
    .section h2 { 
      color: #63b3ed; 
      margin-bottom: 1.5rem; 
      font-size: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .vuln-list { display: flex; flex-direction: column; gap: 1rem; }
    .vuln-item { 
      padding: 1.25rem; 
      border-left: 4px solid; 
      background: rgba(0,0,0,0.2); 
      border-radius: 0 8px 8px 0;
      transition: transform 0.2s;
    }
    .vuln-item:hover { transform: translateX(4px); }
    .vuln-item.HIGH { border-color: #fc8181; }
    .vuln-item.MEDIUM { border-color: #ecc94b; }
    .vuln-item.LOW { border-color: #48bb78; }
    
    .vuln-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; }
    .severity-badge { 
      display: inline-block; 
      padding: 0.3rem 0.75rem; 
      border-radius: 6px; 
      font-size: 0.75rem; 
      font-weight: bold; 
      color: white; 
    }
    .severity-badge.HIGH { background: #e53e3e; }
    .severity-badge.MEDIUM { background: #d69e2e; }
    .severity-badge.LOW { background: #38a169; }
    
    .rule-id { font-weight: 600; color: #e2e8f0; }
    .vuln-desc { color: #a0aec0; margin-bottom: 0.5rem; }
    .vuln-fix { color: #4fd1c5; font-style: italic; font-size: 0.9rem; }
    
    .footer { 
      text-align: center; 
      color: #4a5568; 
      font-size: 0.85rem; 
      margin-top: 3rem;
      padding: 2rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🔒 DevSecOps Security Report</h1>
      <div class="meta">
        <p><strong>Report ID:</strong> {{id}}</p>
        <p><strong>Generated:</strong> {{generatedAt}}</p>
        {{#if scan_id}}<p><strong>Scan ID:</strong> {{scan_id}}</p>{{/if}}
      </div>
    </div>
    
    <div class="score-card">
      <div class="score {{scoreClass}}">{{metrics.score}}</div>
      <div class="grade">Grade: {{metrics.grade}} / 100</div>
      <div class="summary">
        <div class="summary-item">
          <div class="summary-count high">{{summary.high}}</div>
          <div class="summary-label">High</div>
        </div>
        <div class="summary-item">
          <div class="summary-count medium">{{summary.medium}}</div>
          <div class="summary-label">Medium</div>
        </div>
        <div class="summary-item">
          <div class="summary-count low">{{summary.low}}</div>
          <div class="summary-label">Low</div>
        </div>
      </div>
    </div>
    
    {{#if vulnerabilities.length}}
    <div class="section">
      <h2>⚠️ Vulnerabilities ({{summary.total}})</h2>
      <div class="vuln-list">
        {{#each vulnerabilities}}
        <div class="vuln-item {{severity}}">
          <div class="vuln-header">
            <span class="severity-badge {{severity}}">{{severity}}</span>
            <span class="rule-id">{{rule_id}}</span>
          </div>
          <p class="vuln-desc">{{description}}</p>
          {{#if remediation}}<p class="vuln-fix">💡 {{remediation}}</p>{{/if}}
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}
    
    {{#if suggestions.length}}
    <div class="section">
      <h2>💡 Suggestions</h2>
      {{#each suggestions}}
      <div class="vuln-item LOW">
        <strong>{{title}}</strong>
        {{#if description}}<p class="vuln-desc">{{description}}</p>{{/if}}
      </div>
      {{/each}}
    </div>
    {{/if}}
    
    <div class="footer">
      <p>Generated by SafeOps-LogMiner ReportGenerator</p>
      <p>Integrable with GitHub Actions / GitLab CI</p>
    </div>
  </div>
</body>
</html>
